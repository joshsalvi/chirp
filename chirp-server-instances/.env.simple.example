# Copy to .env next to docker-compose.simple.yml and fill in.

# Long random text that signs sign-ins. Make one with:  openssl rand -hex 32
CHIRP_SECRET_KEY=

# The username you'll register first; it becomes the server-wide admin
# (Global Admin page) on the next restart.
CHIRP_GLOBAL_ADMIN_USERNAME=

# The address people use to reach this server, for links in emails,
# e.g. https://chirp.example.com (leave blank until you have one).
CHIRP_SERVER_URL=

# Optional: free key from https://ebird.org/api/keygen (also settable in the app).
CHIRP_EBIRD_API_KEY=

TZ=America/New_York
