# Chirp Server — Environment Configuration
# Copy this to .env and fill in your values.
# Settings configured here persist across Docker rebuilds and reinstalls.

# ── Security ─────────────────────────────────────────────────────────────────
CHIRP_SECRET_KEY=changeme-use-a-long-random-string
CHIRP_DEVICE_API_KEY=chirp-device-key-change-me
CHIRP_ADMIN_PASSWORD=chirp-admin

# ── eBird API ─────────────────────────────────────────────────────────────────
# Free key from https://ebird.org/api/keygen
# Enables Regional Library, species likelihood, and seasonal frequency data
CHIRP_EBIRD_API_KEY=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Set these to persist email config across reinstalls.
# You can also configure them in the Settings UI — they'll be saved to the DB.
# If both are set, the DB value takes priority once saved via the UI.
#
# Gmail example:
#   CHIRP_SMTP_HOST=smtp.gmail.com
#   CHIRP_SMTP_PORT=587
#   CHIRP_SMTP_USERNAME=you@gmail.com
#   CHIRP_SMTP_PASSWORD=your-app-password   # use an App Password, not your main password
#   CHIRP_SMTP_FROM_ADDRESS=you@gmail.com
#   CHIRP_ADMIN_EMAIL=you@gmail.com
#
# SendGrid example:
#   CHIRP_SMTP_HOST=smtp.sendgrid.net
#   CHIRP_SMTP_PORT=587
#   CHIRP_SMTP_USERNAME=apikey
#   CHIRP_SMTP_PASSWORD=SG.your-sendgrid-api-key
#   CHIRP_SMTP_FROM_ADDRESS=chirp@yourdomain.com
CHIRP_SMTP_HOST=
CHIRP_SMTP_PORT=587
CHIRP_SMTP_USERNAME=
CHIRP_SMTP_PASSWORD=
CHIRP_SMTP_FROM_ADDRESS=
CHIRP_SMTP_USE_TLS=true
CHIRP_ADMIN_EMAIL=

# ── Tailscale/Headscale ──────────────────────────────────────────────────────
# Reach this server itself over Tailscale, not just its local network —
# generate a key from https://login.tailscale.com/admin/settings/keys
# (or your own self-hosted Headscale admin console).
#
# If chirp-server-instances is also running on this same machine, it
# bundles a self-hosted Headscale (see its own docker-compose.yml) that
# auto-generates a reusable key with zero manual steps — you can point
# this server at that SAME private tailnet instead of a separate
# Tailscale.com account: set CHIRP_TAILSCALE_LOGIN_SERVER to its
# server_url (headscale/config.yaml over there) and grab a key with
# `docker compose exec headscale cat /shared/authkey`.
CHIRP_TAILSCALE_ENABLED=false
CHIRP_TAILSCALE_AUTH_KEY=
CHIRP_TAILSCALE_LOGIN_SERVER=
CHIRP_TAILSCALE_HOSTNAME=

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/New_York
